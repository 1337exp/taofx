{
  "name": "@1337exp/taofx",
  "version": "0.1.0",
  "description": "Node-based visual effects editor and runtime. One graph compiles to three.js (TSL and GLSL) and PIXI",
  "keywords": [
    "vfx",
    "visual-effects",
    "particles",
    "shaders",
    "threejs",
    "pixijs",
    "webgpu",
    "tsl",
    "glsl",
    "node-editor"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/1337exp/taofx#readme",
  "repository": { "type": "git", "url": "git+https://github.com/1337exp/taofx.git" },
  "bugs": { "url": "https://github.com/1337exp/taofx/issues" },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tsl": {
      "types": "./dist/lib/tsl.d.ts",
      "import": "./dist/tsl.js"
    },
    "./three": {
      "types": "./dist/lib/three.d.ts",
      "import": "./dist/three.js"
    },
    "./pixi": {
      "types": "./dist/lib/pixi.d.ts",
      "import": "./dist/pixi.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib"
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0",
    "three": ">=0.186.0"
  },
  "peerDependenciesMeta": {
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1337exp/taoui": "file:../taoui",
    "@1337exp/taoux": "file:../taoux",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "pinia": "^4.1.0",
    "pixi.js": "^8.0.0",
    "three": "^0.186.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
